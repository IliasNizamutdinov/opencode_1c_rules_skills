{
  "$schema": "https://opencode.ai/config.json",
  "skills": [
    "./.opencode/skills",
    "./skills"
  ],
  "instructions": [
    "rules/bsl/1c-bsl-runtime-specifics.md",
    "rules/bsl/1c-coding-standards.md",
    "rules/bsl/1c-transactions-and-locks.md",
    "rules/bsl/1c77-specifics.md",
    "rules/bsl/async-methods-1c.md",
    "rules/bsl/refactoring.md",
    "rules/bsl/text-formatting.md",
    "rules/bsp/bsl-ssl.md",
    "rules/bsp/bsp-profile-rights-api.md",
    "rules/bsp/routine_assignment_ext_processor.md",
    "rules/exchange/1c-exchange-specifics.md",
    "rules/extensions/1c-extension-patterns.md",
    "rules/extensions/1c-extension-specifics.md",
    "rules/forms/1c-form-reserved-names.md",
    "rules/forms/1c-managed-forms-specifics.md",
    "rules/forms/1c-ordinary-forms.md",
    "rules/forms/edt-form-xml-requirements.md",
    "rules/forms/form_module_rules.md",
    "rules/forms/forms_events.md",
    "rules/forms/forms_generation.md",
    "rules/metadata/1c-mdo-integrity.md",
    "rules/metadata/edt-bsl-write-safety.md",
    "rules/metadata/edt-known-errors.md",
    "rules/metadata/edt-source-format.md",
    "rules/metadata/edt-thick-client-monopoly.md",
    "rules/metadata/edt-zip-export-pitfalls.md",
    "rules/metadata/external-data-source-mdo.md",
    "rules/metadata/v8unpack-source-structure.md",
    "rules/performance/anti_patterns.md",
    "rules/performance/query-optimization-tips.md",
    "rules/queries/1c-query-specifics.md",
    "rules/queries/1c-report-direct-query.md",
    "rules/security/1c-role-rights.md",
    "rules/security/git-safety-rules.md",
    "rules/skd/1c-skd-specifics.md",
    "rules/skd/1c-skd-two-pass-preprocessing.md",
    "rules/workflow/1c-cyrillic-windows.md",
    "rules/workflow/agent-verification-patterns.md",
    "rules/workflow/agent-working-memory.md",
    "rules/workflow/code-exploration-guide.md",
    "rules/workflow/code-review-checklist.md",
    "rules/workflow/designer-batch-verdict.md",
    "rules/workflow/file-edit-efficiency.md",
    "rules/workflow/integrations.md",
    "rules/workflow/mcp-tool-priority.md",
    "rules/workflow/model-selection.md",
    "rules/workflow/sdd-workflow.md",
    "rules/workflow/skill-design.md",
    "rules/workflow/testing-patterns.md"
  ],
  "command": {
    "check-uuid": {
      "description": "Проверить уникальность UUID в выгрузке 1С",
      "template": "Прочитай commands/check-uuid.md и выполни эту команду. Аргументы пользователя: $ARGUMENTS"
    },
    "browser-debug": {
      "description": "Запустить Яндекс Браузер с портом удаленной отладки",
      "template": "Прочитай commands/browser-debug.md и выполни эту команду. Аргументы пользователя: $ARGUMENTS"
    },
    "docx-to-md": {
      "description": "Конвертировать DOCX в Markdown",
      "template": "Прочитай commands/docx-to-md.md и выполни эту команду. Аргументы пользователя: $ARGUMENTS"
    },
    "move-project": {
      "description": "Перенести каталог проекта, не правя базу сессий OpenCode",
      "template": "Прочитай commands/move-project.md и выполни эту команду. Аргументы пользователя: $ARGUMENTS"
    },
    "quality": {
      "description": "Снятие гейта качества в OpenCode недоступно",
      "template": "Прочитай commands/quality.md и выполни эту команду. Аргументы пользователя: $ARGUMENTS"
    }
  }
}
